#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = C:\Programs\CMake\bin\cmake.exe --regenerate-during-build -SC:\dev\XboxLldbServer -BC:\dev\XboxLldbServer\build
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for re-checking globbed directories.

rule VERIFY_GLOBS
  command = C:\Programs\CMake\bin\cmake.exe -P C:\dev\XboxLldbServer\build\CMakeFiles\VerifyGlobs.cmake
  description = Re-checking globbed directories...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = C:\Programs\ninja\ninja.exe $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = C:\Programs\ninja\ninja.exe -t targets
  description = All primary targets available:

