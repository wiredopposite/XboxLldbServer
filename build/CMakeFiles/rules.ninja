rule C_STATIC_LIBRARY_LINKER__nxdk_zlib_Debug
  command = C:\WINDOWS\system32\cmd.exe /C "$PRE_LINK && C:\Programs\CMake\bin\cmake.exe -E rm -f $TARGET_FILE && C:\PROGRA~1\LLVM\bin\llvm-ar.exe qc $TARGET_FILE $LINK_FLAGS $in && C:\PROGRA~1\LLVM\bin\LLVM-R~1.EXE $TARGET_FILE && $POST_BUILD"
  description = Linking C static library $TARGET_FILE
  restat = $RESTAT


